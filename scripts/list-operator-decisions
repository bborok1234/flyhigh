#!/usr/bin/env python3
import json
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "operator-decisions.jsonl"
    rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()] if path.exists() else []
    for row in rows:
        print(f"\n{row.get('id')} {row.get('title')} [{row.get('status')}]")
        print(f"추천: {row.get('recommendation_label')} ({row.get('recommendation')})")
        print(f"자율성: {row.get('autonomy_level')} / 범위: {row.get('approval_scope')} / 위험: {row.get('risk_level')}")
        print(f"명령: {row.get('copy_command')}")
        print(f"이유: {row.get('rationale')}")
        print("선택지:")
        for option in row.get("options", []):
            print(f"- {option.get('label')} [{option.get('approval_scope')}]: {option.get('impact')}")
            print(f"  후속: {option.get('follow_up')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
