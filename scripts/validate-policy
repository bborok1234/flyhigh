#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path


def check(root: Path, kind: str, value: str, expected: str) -> str | None:
    result = subprocess.run(["scripts/check-policy", "--kind", kind, "--value", value, "--json"], cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if result.returncode != 0:
        return result.stderr or result.stdout
    data = json.loads(result.stdout)
    if data["class"] != expected:
        return f"{kind}={value} expected {expected} got {data['class']}"
    return None


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    policy_path = root / "policies" / "default-policy.json"
    errors: list[str] = []
    if not policy_path.exists():
        errors.append("missing policies/default-policy.json")
    else:
        policy = json.loads(policy_path.read_text(encoding="utf-8"))
        for key in ["name", "version", "classes", "rules"]:
            if key not in policy:
                errors.append(f"policy missing {key}")
        classes = set(policy.get("classes", []))
        for required in ["allow", "rationale_required", "approval_required", "deny"]:
            if required not in classes:
                errors.append(f"policy class missing {required}")
    for params in [
        ("command", "rg pattern", "allow"),
        ("file", "package.json", "rationale_required"),
        ("command", "rm -rf build", "approval_required"),
        ("content", "domain-specific strategy inside Flyhigh core", "deny"),
    ]:
        error = check(root, *params)
        if error:
            errors.append(error)
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("policy ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

