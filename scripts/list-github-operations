#!/usr/bin/env python3
import json
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "github" / "operations.jsonl"
    rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()] if path.exists() else []
    for lane in ["needs_approval", "approved", "prepared", "published", "blocked"]:
        print(f"\n[{lane}]")
        for row in rows:
            if row.get("lane") == lane:
                print(f"- {row.get('id')} {row.get('kind')} {row.get('title')}")
                print(f"  왜: {row.get('why', '')}")
                print(f"  다음: {row.get('next_action', '')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
