#!/usr/bin/env python3
import json
import sys
from pathlib import Path


REQUIRED = ["id", "timestamp", "title", "context", "decision", "rationale", "alternatives_rejected", "evidence", "affected_files", "status", "follow_up"]


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "decisions.jsonl"
    errors: list[str] = []
    if not path.exists():
        print("missing state/decisions.jsonl", file=sys.stderr)
        return 1
    seen: set[str] = set()
    count = 0
    for idx, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        count += 1
        try:
            item = json.loads(line)
        except json.JSONDecodeError as exc:
            errors.append(f"line {idx}: invalid JSON {exc}")
            continue
        for key in REQUIRED:
            if key not in item:
                errors.append(f"{item.get('id', idx)} missing {key}")
        if item.get("id") in seen:
            errors.append(f"duplicate id {item.get('id')}")
        seen.add(item.get("id", ""))
        if not item.get("evidence"):
            errors.append(f"{item.get('id', idx)} missing evidence")
    if count == 0:
        errors.append("no decisions recorded")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"decisions ok ({count} recorded)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

