#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit a project for Flyhigh installation readiness.")
    parser.add_argument("target")
    args = parser.parse_args()
    target = Path(args.target).resolve()
    checks = {
        "agents": (target / "AGENTS.md").exists() or (target / "AGENTS.flyhigh.generated.md").exists(),
        "memory": (target / ".flyhigh" / "memory").exists(),
        "domain_skills": (target / ".flyhigh" / "domain-skills").exists(),
        "runs": (target / "reports" / "runs").exists(),
        "dashboard_state": (target / ".flyhigh" / "dashboard" / "state.json").exists(),
    }
    print(json.dumps({"target": str(target), "checks": checks, "passed": all(checks.values())}, indent=2))
    return 0 if all(checks.values()) else 1


if __name__ == "__main__":
    raise SystemExit(main())

