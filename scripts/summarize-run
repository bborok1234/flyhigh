#!/usr/bin/env python3
import json
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: summarize-run <run-directory>", file=sys.stderr)
        return 2

    run_dir = Path(sys.argv[1])
    manifest_path = run_dir / "manifest.json"
    if not manifest_path.exists():
        print("missing manifest.json", file=sys.stderr)
        return 1

    manifest = json.loads(manifest_path.read_text())
    print(f"Task: {manifest.get('task', 'unknown')}")
    print(f"Repo: {manifest.get('repo', 'unknown')}")
    print(f"Agent: {manifest.get('agent_surface', 'unknown')}")
    print("Artifacts:")
    for artifact in manifest.get("artifacts", []):
        print(f"- {artifact}")
    print("Validation:")
    for check in manifest.get("validation", []):
        print(f"- {check}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

