#!/usr/bin/env python3
import argparse
import json
import re
from datetime import date, datetime, timezone
from pathlib import Path


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-zA-Z0-9]+", "-", value.lower()).strip("-")
    return slug[:80] or "run"


def main() -> int:
    parser = argparse.ArgumentParser(description="Create a Flyhigh run artifact folder.")
    parser.add_argument("task", help="Task title or short description.")
    parser.add_argument("--repo", default=".", help="Target repository path.")
    parser.add_argument("--slug", default="", help="Optional run slug.")
    parser.add_argument("--skill", action="append", default=[], help="Skill used for this run. Repeatable.")
    args = parser.parse_args()

    repo = Path(args.repo).resolve()
    if not repo.exists() or not repo.is_dir():
        parser.error(f"repo is not a directory: {repo}")

    run_slug = args.slug or slugify(args.task)
    run_dir = repo / "reports" / "runs" / f"{date.today().isoformat()}-{run_slug}"
    run_dir.mkdir(parents=True, exist_ok=True)

    manifest = {
        "task": args.task,
        "repo": str(repo),
        "started_at": datetime.now(timezone.utc).isoformat(),
        "agent_surface": "codex",
        "skills": args.skill,
        "constraints": [],
        "artifacts": [
            "manifest.json",
            "plan.md",
            "events.jsonl",
            "tool-calls.jsonl",
            "verification.md",
            "final.md"
        ],
        "validation": [],
        "status": "created"
    }

    files = {
        "manifest.json": json.dumps(manifest, indent=2) + "\n",
        "plan.md": f"# Plan\n\nTask: {args.task}\n\n## Target Result\n\n## Constraints\n\n## Steps\n\n",
        "events.jsonl": "",
        "tool-calls.jsonl": "",
        "verification.md": "# Verification\n\n## Claim\n\n## Evidence\n\n## Gaps\n\n",
        "final.md": "# Final\n\n## Summary\n\n## Files Changed\n\n## Validation\n\n## Next Step\n\n",
    }
    for name, content in files.items():
        path = run_dir / name
        if not path.exists():
            path.write_text(content, encoding="utf-8")

    print(run_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

