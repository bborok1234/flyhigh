#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Update a Flyhigh Kanban issue lane/status.")
    parser.add_argument("id")
    parser.add_argument("--lane", choices=["todo", "doing", "review", "done"])
    parser.add_argument("--status")
    parser.add_argument("--evidence")
    parser.add_argument("--next-action")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "issues.jsonl"
    rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
    updated = False
    for row in rows:
        if row["id"] == args.id:
            if args.lane:
                row["lane"] = args.lane
                row["status"] = args.status or args.lane
            elif args.status:
                row["status"] = args.status
            if args.evidence:
                row.setdefault("evidence", []).append(args.evidence)
            if args.next_action is not None:
                row["next_action"] = args.next_action
            updated = True
    if not updated:
        raise SystemExit(f"issue not found: {args.id}")
    path.write_text("\n".join(json.dumps(row, ensure_ascii=False) for row in rows) + "\n", encoding="utf-8")
    print(f"updated {args.id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

