#!/usr/bin/env python3
import json
import subprocess
import tempfile
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    with tempfile.TemporaryDirectory() as tmp:
        repo = Path(tmp) / "repo"
        repo.mkdir()
        commands = repo / "commands.txt"
        changed = repo / "changed.txt"
        commands.write_text("rm -rf build\nnpm test\n", encoding="utf-8")
        changed.write_text("package.json\n.env\nsrc/app.ts\n", encoding="utf-8")
        result = subprocess.run(
            [
                str(root / "scripts" / "policy-preflight"),
                "--root",
                str(repo),
                "--commands-file",
                str(commands),
                "--changed-files-file",
                str(changed),
                "--json",
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if result.returncode != 0:
            print(result.stdout)
            print(result.stderr)
            return result.returncode
        data = json.loads(result.stdout)
        kinds = {warning["kind"] for warning in data["warnings"]}
        expected = {"destructive-command", "dependency-change", "secret-file"}
        missing = expected - kinds
        if missing:
            print(f"missing policy warnings: {sorted(missing)}")
            return 1
    print("policy fixture ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

