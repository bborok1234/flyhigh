#!/usr/bin/env python3
import argparse
import json
from datetime import datetime, timezone
from pathlib import Path


def split_values(value: str) -> list[str]:
    return [item.strip() for item in value.split("|") if item.strip()]


def load_rows(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def write_rows(path: Path, rows: list[dict]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(json.dumps(row, ensure_ascii=False) for row in rows) + "\n", encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description="Record a durable Flyhigh decision.")
    parser.add_argument("--id", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--context", required=True)
    parser.add_argument("--decision", required=True)
    parser.add_argument("--rationale", required=True)
    parser.add_argument("--rejected", default="", help="Pipe-separated rejected alternatives.")
    parser.add_argument("--evidence", default="", help="Pipe-separated evidence paths.")
    parser.add_argument("--files", default="", help="Pipe-separated affected files.")
    parser.add_argument("--status", default="accepted")
    parser.add_argument("--follow-up", default="")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "decisions.jsonl"
    entry = {
        "id": args.id,
        "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
        "title": args.title,
        "context": args.context,
        "decision": args.decision,
        "rationale": args.rationale,
        "alternatives_rejected": split_values(args.rejected),
        "evidence": split_values(args.evidence),
        "affected_files": split_values(args.files),
        "status": args.status,
        "follow_up": args.follow_up,
    }
    rows = [row for row in load_rows(path) if row.get("id") != args.id]
    rows.append(entry)
    write_rows(path, rows)
    print(f"upserted {args.id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
