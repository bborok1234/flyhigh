#!/usr/bin/env python3
import argparse
import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Reject a staged skill edit with evidence.")
    parser.add_argument("candidate_id")
    parser.add_argument("--reason", required=True)
    parser.add_argument("--evidence", action="append", default=[])
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    patch_path = root / "skills" / "staging" / args.candidate_id / "patch.json"
    patch = json.loads(patch_path.read_text(encoding="utf-8")) if patch_path.exists() else {"skill": "unknown"}
    entry = {
        "id": args.candidate_id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "skill": patch.get("skill", "unknown"),
        "reason": args.reason,
        "evidence": args.evidence,
        "status": "rejected"
    }
    with (root / "state" / "skillopt" / "rejected-edits.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
    if patch_path.exists():
        patch["status"] = "rejected"
        patch_path.write_text(json.dumps(patch, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    subprocess.run(["scripts/render-dashboard"], cwd=root, check=False)
    print(f"rejected {args.candidate_id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
