  --faint:#8b96a8;
  --line:#dce2ea;
  --line-soft:#edf1f5;
  --accent:#275cc8;
  --accent-soft:#e8efff;
  --ok:#147a4a;
  --ok-soft:#e7f6ee;
  --warn:#a05a00;
  --warn-soft:#fff3df;
  --shadow:0 1px 2px rgba(20,32,50,.04), 0 16px 38px rgba(20,32,50,.06);
