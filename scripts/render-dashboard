#!/usr/bin/env python3
import html
import json
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ISSUE_LANES = ["todo", "doing", "review", "done"]
ISSUE_LABELS = {"todo": "대기", "doing": "진행", "review": "검증", "done": "완료"}
GITHUB_LANES = ["needs_approval", "approved", "prepared", "published", "blocked"]
GITHUB_LABELS = {
    "needs_approval": "승인 대기",
    "approved": "승인됨",
    "prepared": "아웃박스 준비",
    "published": "게시됨",
    "blocked": "보류",
}
DISPLAY_LABELS = {
    "explicit_approval_required": "명시 승인",
    "recommend_then_apply": "추천 후 적용",
    "auto": "자동",
    "publish_issue": "이슈 게시",
    "local_apply": "로컬 적용",
    "prepare_only": "준비만",
    "draft_only": "초안만",
    "open_pr": "PR 생성",
    "merge_pr": "PR 병합",
    "delete_or_reset": "삭제/리셋",
    "spend_or_call": "비용/API",
    "reversible": "되돌릴 수 있음",
    "partially_reversible": "부분 되돌림",
    "irreversible": "되돌릴 수 없음",
    "low": "낮음",
    "medium": "중간",
    "high": "높음",
}


def load_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def load_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def esc(value: Any) -> str:
    return html.escape(str(value))


def rel_path(root: Path, path: Path) -> str:
    try:
        return path.relative_to(root).as_posix()
    except ValueError:
        return str(path)


def status_text(value: Any) -> str:
    if value is True:
        return "통과"
    if value is False:
        return "실패"
    return "미확인"


def pill(text: str, tone: str = "neutral") -> str:
    return f"<span class='pill {tone}'>{esc(text)}</span>"


def display_value(value: Any) -> str:
    return DISPLAY_LABELS.get(str(value), str(value))


def evidence_list(values: list[Any]) -> str:
    if not values:
        return "<p class='empty'>기록 없음</p>"
    return "<ul class='evidence'>" + "".join(f"<li>{esc(value)}</li>" for value in values) + "</ul>"


def card(title: str, body: str, subtitle: str = "") -> str:
    subtitle_html = f"<p class='section-note'>{esc(subtitle)}</p>" if subtitle else ""
    return f"<section class='panel'><div class='section-head'><h2>{esc(title)}</h2>{subtitle_html}</div>{body}</section>"


def latest(rows: list[dict[str, Any]], count: int = 1) -> list[dict[str, Any]]:
    return rows[-count:][::-1]


def short_iteration(item: dict[str, Any] | None) -> str:
    if not item:
        return "반복 기록 없음"
    status = item.get("status", "")
    goal = item.get("goal", "")
    if item.get("id") == "ITER-AUTO-LATEST":
        return "자동 검증 통과"
    return f"{goal} · {status}" if status else goal


def count_by(rows: list[dict[str, Any]], key: str) -> Counter:
    return Counter(row.get(key, "") for row in rows)


def metric(label: str, value: Any, detail: str = "", tone: str = "neutral") -> str:
    return (
        f"<article class='metric {tone}'>"
        f"<span>{esc(label)}</span>"
        f"<strong>{esc(value)}</strong>"
        f"<small>{esc(detail)}</small>"
        "</article>"
    )


def issue_summary(issues: list[dict[str, Any]]) -> str:
    counts = count_by(issues, "lane")
    return "<div class='metrics'>" + "".join([
        metric("진행 중", counts["doing"], "현재 작업", "focus"),
        metric("검증 대기", counts["review"], "품질 확인 필요", "warn" if counts["review"] else "neutral"),
        metric("다음 후보", counts["todo"], "아직 시작 전", "neutral"),
        metric("완료", counts["done"], "누적", "ok"),
    ]) + "</div>"


def github_summary(ops: list[dict[str, Any]], sync_rows: list[dict[str, Any]], repositories: dict[str, Any]) -> str:
    counts = count_by(ops, "lane")
    dry_runs = sum(1 for row in ops if row.get("dry_run_command"))
    repo_rows = repositories.get("repositories", [])
    mapped = len(repo_rows)
    ready = sum(1 for row in repo_rows if row.get("publish_ready"))
    return "<div class='metrics'>" + "".join([
        metric("승인 대기", counts["needs_approval"], "승인 필요 없음" if not counts["needs_approval"] else "승인 필요", "warn" if counts["needs_approval"] else "ok"),
        metric("아웃박스 준비", counts["prepared"], "게시 전 검토", "focus" if counts["prepared"] else "neutral"),
        metric("Dry-run", dry_runs, "원격 쓰기 없음", "ok"),
        metric("Repo mapping", f"{ready}/{mapped}", "publish-ready", "ok" if mapped and ready == mapped else "warn"),
    ]) + "</div>"


def validation_summary(root: Path) -> str:
    full = load_json(root / "evals" / "reports" / "full-harness-validation.json", {})
    v1 = load_json(root / "evals" / "reports" / "v1-validation.json", {})
    evals = load_json(root / "evals" / "reports" / "all.json", {})
    failures = full.get("failures", [])
    return "<div class='metrics'>" + "".join([
        metric("전체 검증", "통과" if not failures and full else "미확인", "full harness", "ok" if not failures and full else "warn"),
        metric("V1 게이트", "통과" if v1.get("failures") == [] else status_text(v1.get("passed")), "domain neutral", "ok" if v1.get("failures") == [] else "warn"),
        metric("Eval", status_text(evals.get("passed")), f"{len(evals.get('results', []))} suites", "ok" if evals.get("passed") else "warn"),
        metric("실패", len(failures), "현재 보고", "warn" if failures else "ok"),
    ]) + "</div>"


def briefing(full: dict[str, Any], issues: list[dict[str, Any]], ops: list[dict[str, Any]], iterations: list[dict[str, Any]], operator_decisions: list[dict[str, Any]], generated_at: str) -> str:
    doing = [issue for issue in issues if issue.get("lane") == "doing"]
    review = [issue for issue in issues if issue.get("lane") == "review"]
    prepared = [row for row in ops if row.get("lane") == "prepared"]
    last_iteration = latest(iterations, 1)
    focus = doing[0]["title"] if doing else "진행 중인 작업 없음"
    risk = review[0]["title"] if review else "검증 대기 항목 없음"
    github = f"{len(prepared)}건 dry-run 준비" if prepared else "승인 대기 없음"
    open_decisions = sum(1 for row in operator_decisions if row.get("status") == "open")
    last = short_iteration(last_iteration[0] if last_iteration else None)
    return (
        "<section class='briefing'>"
        "<div>"
        "<span class='surface-label'>운영 브리핑</span>"
        "<h1>Flyhigh 운영 대시보드</h1>"
        f"<p>{esc(full.get('current_state', 'SSOT 기반 개인 엔지니어링 하네스 운영판'))}</p>"
        "</div>"
        "<dl class='brief-grid'>"
        f"<div><dt>지금 볼 것</dt><dd>{esc(focus)}</dd></div>"
        f"<div><dt>검증 관심</dt><dd>{esc(risk)}</dd></div>"
        f"<div><dt>GitHub 준비</dt><dd>{esc(github)}</dd></div>"
        f"<div><dt>결정 필요</dt><dd>{open_decisions}건</dd></div>"
        f"<div><dt>최근 반복</dt><dd>{esc(last)}</dd></div>"
        f"<div><dt>생성</dt><dd>{esc(generated_at)}</dd></div>"
        "</dl>"
        "</section>"
    )


def decision_console(decisions: list[dict[str, Any]]) -> str:
    open_rows = [row for row in decisions if row.get("status") in {"open", "answered", "applied"}]
    if not open_rows:
        return (
            "<section class='decision-console'>"
            "<div class='section-head'><div><span class='surface-label'>Decision Console</span><h2>운영자 결정 없음</h2></div>"
            "<p class='section-note'>현재 승인하거나 방향을 정해야 할 항목이 없습니다.</p></div>"
            "</section>"
        )
    cards = []
    for row in open_rows:
        options = row.get("options", [])
        recommendation = row.get("recommendation", "")
        option_cards = []
        for option in options:
            selected = option.get("id") == recommendation
            option_cards.append(
                f"<article class='decision-option {'selected' if selected else ''}'>"
                f"<div><strong>{esc(option.get('label', ''))}</strong><span class='option-meta'>{pill(display_value(option.get('approval_scope', '')), 'neutral')}{pill('추천', 'ok') if selected else ''}</span></div>"
                f"<p><span>영향</span>{esc(option.get('impact', ''))}</p>"
                f"<p><span>후속</span>{esc(option.get('follow_up', ''))}</p>"
                "</article>"
            )
        evidence = evidence_list(row.get("evidence", []))
        copy_command = row.get("copy_command") or f"{row.get('id', '')} approve {row.get('approval_scope', '')}"
        governance = [
            ("자율성", display_value(row.get("autonomy_level", ""))),
            ("승인 범위", display_value(row.get("approval_scope", ""))),
            ("되돌림", display_value(row.get("reversibility", ""))),
            ("위험", display_value(row.get("risk_level", ""))),
        ]
        governance_html = "".join(
            f"<div><span>{esc(label)}</span><strong>{esc(value)}</strong></div>" for label, value in governance
        )
        cards.append(
            "<article class='decision-card'>"
            "<div class='decision-top'>"
            f"<div><span class='micro'>{esc(row.get('id', ''))} · {esc(row.get('source_id', ''))}</span><h3>{esc(row.get('title', ''))}</h3></div>"
            f"{pill(row.get('owner', 'operator'), 'neutral')}"
            "</div>"
            f"<div class='governance-grid'>{governance_html}</div>"
            f"<p class='decision-question'>{esc(row.get('question', ''))}</p>"
            "<div class='recommendation'>"
            "<span>추천</span>"
            f"<strong>{esc(row.get('recommendation_label', ''))}</strong>"
            f"<p>{esc(row.get('rationale', ''))}</p>"
            "</div>"
            f"<div class='decision-options'><div class='option-label'>선택지</div>{''.join(option_cards)}</div>"
            f"<p class='decision-risk'><span>리스크</span>{esc(row.get('risk', ''))}</p>"
            f"<p class='apply-gate'><span>Apply gate</span>{esc(row.get('apply_gate', ''))}</p>"
            f"<p class='execution-path'><span>실행 경로</span>{esc(row.get('execution_path', ''))}</p>"
            "<div class='copy-command'>"
            "<span>에이전트에게 전달할 명령</span>"
            f"<code>{esc(copy_command)}</code>"
            "</div>"
            f"<details><summary>Stale context guard</summary>{evidence_list(row.get('valid_until_context_changes', []))}</details>"
            f"<details><summary>판단 근거</summary>{evidence}</details>"
            "</article>"
        )
    return (
        "<section class='decision-console'>"
        "<div class='section-head'><div><span class='surface-label'>Decision Console</span><h2>지금 결정해야 할 항목</h2></div>"
        "<p class='section-note'>운영자가 짧은 명령으로 scope를 승인하면 하네스가 기록, apply gate, 감사 로그, 재렌더링까지 처리합니다.</p></div>"
        f"<div class='decision-list'>{''.join(cards)}</div>"
        "</section>"
    )


def action_queue(issues: list[dict[str, Any]], ops: list[dict[str, Any]]) -> str:
    actions: list[tuple[str, str, str, str]] = []
    for row in ops:
        if row.get("lane") in {"needs_approval", "prepared", "blocked"}:
            actions.append((row.get("id", ""), row.get("title", ""), row.get("next_action", ""), "GitHub"))
    for issue in issues:
        if issue.get("lane") in {"doing", "review", "todo"}:
            actions.append((issue.get("id", ""), issue.get("title", ""), issue.get("next_action", ""), "Work"))
    if not actions:
        return "<p class='empty'>운영자가 지금 판단할 항목이 없습니다.</p>"
    rows = []
    for item_id, title, next_action, source in actions[:8]:
        rows.append(
            "<tr>"
            f"<td>{pill(source, 'neutral')}</td>"
            f"<td><strong>{esc(item_id)}</strong><span>{esc(title)}</span></td>"
            f"<td>{esc(next_action)}</td>"
            "</tr>"
        )
    return "<table class='action-table'><thead><tr><th>출처</th><th>항목</th><th>다음 행동</th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"


def lane_card(item: dict[str, Any], kind: str = "issue") -> str:
    title = item.get("title", "")
    body = item.get("why", item.get("summary", ""))
    next_action = item.get("next_action", "")
    meta = item.get("priority", item.get("kind", ""))
    dry_run = item.get("dry_run_command", "")
    dry_run_html = f"<code class='command'>{esc(dry_run)}</code>" if dry_run else ""
    evidence = evidence_list(item.get("evidence", []))
    approved = item.get("approved_by")
    approved_html = f"<p class='micro'>승인자: {esc(approved)}</p>" if approved else ""
    return (
        f"<article class='work-card {kind}'>"
        f"<div class='card-top'><strong>{esc(item.get('id', ''))}</strong>{pill(meta, 'neutral') if meta else ''}</div>"
        f"<h3>{esc(title)}</h3>"
        f"<p>{esc(body)}</p>"
        f"{approved_html}"
        f"{dry_run_html}"
        f"<p class='next'>{esc(next_action)}</p>"
        f"<details><summary>근거</summary>{evidence}</details>"
        "</article>"
    )


def issue_board(issues: list[dict[str, Any]]) -> str:
    columns = []
    for lane in ISSUE_LANES:
        lane_items = [row for row in issues if row.get("lane") == lane]
        if lane == "done":
            visible = lane_items[-3:]
            hidden_count = max(len(lane_items) - len(visible), 0)
        else:
            visible = lane_items
            hidden_count = 0
        content = "".join(lane_card(item) for item in visible) or "<p class='empty'>없음</p>"
        if hidden_count:
            content += f"<p class='micro'>{hidden_count}개 완료 항목은 요약에서 제외됨</p>"
        columns.append(
            "<section class='lane'>"
            f"<header><span>{esc(ISSUE_LABELS[lane])}</span><strong>{len(lane_items)}</strong></header>"
            f"{content}"
            "</section>"
        )
    return "<div class='board board-four'>" + "".join(columns) + "</div>"


def github_board(ops: list[dict[str, Any]]) -> str:
    columns = []
    for lane in GITHUB_LANES:
        lane_items = [row for row in ops if row.get("lane") == lane]
        content = "".join(lane_card(item, "github") for item in lane_items) or "<p class='empty'>없음</p>"
        columns.append(
            "<section class='lane'>"
            f"<header><span>{esc(GITHUB_LABELS[lane])}</span><strong>{len(lane_items)}</strong></header>"
            f"{content}"
            "</section>"
        )
    return "<div class='board board-five'>" + "".join(columns) + "</div>"


def github_repository_panel(repositories: dict[str, Any]) -> str:
    auth = repositories.get("auth", {})
    repo_rows = repositories.get("repositories", [])
    auth_state = "인증됨" if auth.get("authenticated") else "미인증"
    rows = [
        "<tr>"
        f"<td><strong>auth</strong><span>{esc(auth.get('provider', 'github.com'))}</span></td>"
        f"<td>{pill(auth_state, 'ok' if auth.get('authenticated') else 'warn')}</td>"
        f"<td>{esc(auth.get('account', 'unknown'))}</td>"
        f"<td>{esc(auth.get('git_protocol', ''))}</td>"
        f"<td>{esc('remote write 없음' if not auth.get('remote_write_performed') else 'remote write 발생')}</td>"
        "</tr>"
    ]
    for repo in repo_rows:
        blockers = ", ".join(repo.get("publish_blockers", [])) or "없음"
        rows.append(
            "<tr>"
            f"<td><strong>{esc(repo.get('id', ''))}</strong><span>{esc(repo.get('role', ''))}</span></td>"
            f"<td>{pill('게시 가능' if repo.get('publish_ready') else '게시 차단', 'ok' if repo.get('publish_ready') else 'warn')}</td>"
            f"<td>{esc(repo.get('local_path', ''))}</td>"
            f"<td>{esc(repo.get('remote_url') or 'remote 없음')}</td>"
            f"<td>{esc(blockers)}</td>"
            "</tr>"
        )
    return (
        "<table class='repo-table'><thead><tr><th>Repo</th><th>Readiness</th><th>Local</th><th>Remote</th><th>근거/차단 사유</th></tr></thead>"
        f"<tbody>{''.join(rows)}</tbody></table>"
    )


def direction_review_panel(reviews: list[dict[str, Any]]) -> str:
    if not reviews:
        return "<p class='empty'>방향 리뷰 기록 없음</p>"
    rows = []
    for review in latest(reviews, 4):
        issue_actions = ", ".join(f"{item.get('issue_id')}:{item.get('action')}" for item in review.get("issue_actions", []))
        pr_actions = ", ".join(f"{item.get('repo_id')}#{item.get('pr_number')}:{item.get('action')}" for item in review.get("pr_actions", []))
        rows.append(
            "<article class='timeline-item direction-review'>"
            f"<div><strong>{esc(review.get('review_id', ''))}</strong><span>{esc(review.get('status', ''))} · {esc(review.get('confidence', ''))}</span></div>"
            f"<h3>{esc(review.get('scope', ''))}</h3>"
            f"<p><strong>결정</strong> {esc(review.get('decision', ''))}</p>"
            f"<p><strong>이슈 액션</strong> {esc(issue_actions)}</p>"
            f"<p><strong>PR 액션</strong> {esc(pr_actions)}</p>"
            f"<p>{esc(review.get('rationale', ''))}</p>"
            f"<details><summary>근거</summary>{evidence_list(review.get('evidence', []))}</details>"
            "</article>"
        )
    return "<div class='timeline'>" + "".join(rows) + "</div>"


def merge_gate_panel(gates: list[dict[str, Any]]) -> str:
    if not gates:
        return "<p class='empty'>Merge gate 기록 없음</p>"
    rows = []
    for gate in gates:
        state = gate.get("status", "")
        tone = "ok" if state == "merged" or gate.get("gate_status") == "passed" else "warn" if gate.get("blockers") else "neutral"
        blockers = ", ".join(gate.get("blockers", [])) or "없음"
        rows.append(
            "<tr>"
            f"<td><strong>{esc(gate.get('id', ''))}</strong><span>{esc(gate.get('repo_id', ''))}#{esc(gate.get('pr_number', ''))}</span></td>"
            f"<td>{pill(state, tone)}<span>{esc(gate.get('gate_status', 'not evaluated'))}</span></td>"
            f"<td>{esc(gate.get('direction_review_id', ''))}</td>"
            f"<td>{esc('; '.join(gate.get('validation', [])))}</td>"
            f"<td>{esc(blockers)}</td>"
            "</tr>"
        )
    return "<table><thead><tr><th>Gate</th><th>상태</th><th>방향 리뷰</th><th>검증</th><th>Blockers</th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"


def iteration_list(iterations: list[dict[str, Any]]) -> str:
    if not iterations:
        return "<p class='empty'>반복 기록 없음</p>"
    rows = []
    for item in latest(iterations, 6):
        rows.append(
            "<article class='timeline-item'>"
            f"<div><strong>{esc(item.get('id', ''))}</strong><span>{esc(item.get('status', ''))}</span></div>"
            f"<h3>{esc(item.get('goal', ''))}</h3>"
            f"<p>{esc(item.get('summary', ''))}</p>"
            f"<details><summary>검증</summary>{evidence_list(item.get('validation', []))}</details>"
            "</article>"
        )
    return "<div class='timeline'>" + "".join(rows) + "</div>"


def decision_table(decisions: list[dict[str, Any]], v1_decisions: list[dict[str, Any]]) -> str:
    rows = []
    for row in latest(decisions + v1_decisions, 8):
        rows.append(
            "<tr>"
            f"<td><strong>{esc(row.get('id', ''))}</strong><span>{esc(row.get('status', ''))}</span></td>"
            f"<td>{esc(row.get('title', ''))}</td>"
            f"<td>{esc(row.get('decision', row.get('reason', '')))}</td>"
            f"<td>{esc(row.get('follow_up', ''))}</td>"
            "</tr>"
        )
    if not rows:
        return "<p class='empty'>결정 기록 없음</p>"
    return "<table><thead><tr><th>ID</th><th>결정</th><th>내용</th><th>후속</th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"


def eval_table(root: Path) -> str:
    report = load_json(root / "evals" / "reports" / "all.json", {})
    rows = []
    for item in report.get("results", []):
        rows.append(
            "<tr>"
            f"<td>{esc(item.get('suite'))}</td>"
            f"<td>{pill('통과' if item.get('passed') else '실패', 'ok' if item.get('passed') else 'warn')}</td>"
            f"<td>{esc(', '.join(item.get('evidence', [])))}</td>"
            "</tr>"
        )
    if not rows:
        return "<p class='empty'>eval report 없음</p>"
    return "<table><thead><tr><th>Suite</th><th>결과</th><th>근거 명령</th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"


def system_panel(root: Path, policy: dict[str, Any]) -> str:
    active = sorted(path.parent.name for path in (root / "skills" / "active").glob("*/SKILL.md"))
    staged = sorted(path.parent.name for path in (root / "skills" / "staging").glob("*/patch.json"))
    rows = [
        ("Active skills", str(len(active)), ", ".join(active)),
        ("Staged skill candidates", str(len(staged)), ", ".join(staged) or "없음"),
        ("Policy classes", str(len(policy.get("classes", []))), ", ".join(policy.get("classes", []))),
        ("Policy rules", str(len(policy.get("rules", []))), "policies/default-policy.json"),
        ("Codex surface", "ready", "adapters/codex/AGENTS.md"),
        ("Claude/OpenCode surface", "ready", "adapters/claude, adapters/opencode"),
    ]
    return "<table><thead><tr><th>영역</th><th>상태</th><th>근거</th></tr></thead><tbody>" + "".join(
        f"<tr><td>{esc(name)}</td><td>{esc(value)}</td><td>{esc(detail)}</td></tr>" for name, value, detail in rows
    ) + "</tbody></table>"


def render(root: Path) -> str:
    spec = load_json(root / "spec" / "harness-spec.json", {})
    full = load_json(root / "state" / "full-status.json", {})
    decisions = load_jsonl(root / "state" / "decisions.jsonl")
    v1_decisions = load_jsonl(root / "state" / "v1-decisions.jsonl")
    issues = load_jsonl(root / "state" / "issues.jsonl")
    iterations = load_jsonl(root / "state" / "iterations.jsonl")
    github_ops = load_jsonl(root / "state" / "github" / "operations.jsonl")
    github_sync = load_jsonl(root / "state" / "github" / "sync-log.jsonl")
    github_repositories = load_json(root / "state" / "github" / "repositories.json", {})
    direction_reviews = load_jsonl(root / "state" / "reviews" / "direction-reviews.jsonl")
    merge_gates = load_jsonl(root / "state" / "github" / "merge-gates.jsonl")
    operator_decisions = load_jsonl(root / "state" / "operator-decisions.jsonl")
    policy = load_json(root / "policies" / "default-policy.json", {})
    generated_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    body = "".join([
        briefing(full, issues, github_ops, iterations, operator_decisions, generated_at),
        "<main>",
        decision_console(operator_decisions),
        "<section class='overview-grid'>",
        card("작업 상태", issue_summary(issues), "지금 진행 중인 작업과 검증 대기량"),
        card("GitHub 운영", github_summary(github_ops, github_sync, github_repositories), "승인, 아웃박스, dry-run, repo readiness"),
        card("검증 상태", validation_summary(root), "완료 주장에 필요한 최신 증거"),
        "</section>",
        card("GitHub repository mapping", github_repository_panel(github_repositories), "원격 게시 전 repo, auth, remote, readiness를 확인"),
        "<section class='split'>",
        card("Direction review", direction_review_panel(direction_reviews), "계획 변경, 이슈 분할/보류/생성, PR 진행 판단"),
        card("Merge gates", merge_gate_panel(merge_gates), "PR merge readiness, validation, blockers"),
        "</section>",
        card("지금 판단할 항목", action_queue(issues, github_ops), "운영자가 확인해야 할 다음 행동만 모음"),
        card("작업 칸반", issue_board(issues), "완료 항목은 최근 3개만 노출해 현재 상태를 우선 표시"),
        card("GitHub 운영 보드", github_board(github_ops), "원격 write 없이 proposal, approval, outbox, dry-run을 추적"),
        "<section class='split'>",
        card("최근 반복 로그", iteration_list(iterations), "무엇을 왜 했고 어떤 검증으로 끝났는지"),
        card("결정 메모리", decision_table(decisions, v1_decisions), "다음 세션이 다시 따지지 않아야 할 결정"),
        "</section>",
        "<section class='split'>",
        card("Eval 결과", eval_table(root), "하네스 품질 게이트"),
        card("시스템 표면", system_panel(root, policy), "skills, policy, adapter 준비 상태"),
        "</section>",
        "</main>",
    ])

    purpose = spec.get("purpose", "Codex-first personal engineering harness")
    return f"""<!doctype html>
