#!/usr/bin/env python3
import argparse
import json
from datetime import datetime, timezone
from pathlib import Path


def load_rows(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def write_rows(path: Path, rows: list[dict]) -> None:
    path.write_text("\n".join(json.dumps(row, ensure_ascii=False) for row in rows) + "\n", encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description="Mark a staged GitHub operation as human-approved.")
    parser.add_argument("id")
    parser.add_argument("--approved-by", required=True)
    parser.add_argument("--evidence", default="")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "github" / "operations.jsonl"
    rows = load_rows(path)
    updated = False
    for row in rows:
        if row.get("id") == args.id:
            row["status"] = "approved"
            row["lane"] = "approved"
            row["approved_by"] = args.approved_by
            row["approved_at"] = datetime.now(timezone.utc).isoformat()
            row["next_action"] = "outbox markdown을 생성하고 dry-run publish 명령을 확인한다."
            if args.evidence:
                row.setdefault("evidence", []).append(args.evidence)
            updated = True
    if not updated:
        raise SystemExit(f"operation not found: {args.id}")
    write_rows(path, rows)
    print(f"approved {args.id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
