#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def score(path: Path) -> float:
    data = json.loads(path.read_text(encoding="utf-8"))
    results = data.get("results", [])
    if not results:
        return 0.0
    return sum(float(item.get("score", 0.0)) for item in results) / len(results)


def main() -> int:
    parser = argparse.ArgumentParser(description="Compare two eval report scores.")
    parser.add_argument("before")
    parser.add_argument("after")
    args = parser.parse_args()
    before = score(Path(args.before))
    after = score(Path(args.after))
    print(json.dumps({"before": before, "after": after, "delta": round(after - before, 4), "non_regression": after >= before}, indent=2))
    return 0 if after >= before else 1


if __name__ == "__main__":
    raise SystemExit(main())

