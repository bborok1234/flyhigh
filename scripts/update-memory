#!/usr/bin/env python3
import sys
from datetime import date
from pathlib import Path


def main() -> int:
    if len(sys.argv) < 4:
        print("usage: update-memory <memory-file> <title> <note>", file=sys.stderr)
        return 2

    memory_file = Path(sys.argv[1])
    title = sys.argv[2]
    note = " ".join(sys.argv[3:]).strip()
    memory_file.parent.mkdir(parents=True, exist_ok=True)

    entry = f"\n## {date.today().isoformat()} - {title}\n\n{note}\n"
    with memory_file.open("a", encoding="utf-8") as handle:
        handle.write(entry)

    print(f"updated {memory_file}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

