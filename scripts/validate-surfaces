#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    subprocess.run(["scripts/generate-codex-surface"], cwd=root, check=True)
    subprocess.run(["scripts/generate-adapters"], cwd=root, check=True)
    errors: list[str] = []
    required = [
        "adapters/codex/AGENTS.md",
        "adapters/claude/CLAUDE.md",
        "adapters/opencode/AGENTS.md",
    ]
    for name in required:
        path = root / name
        if not path.exists():
            errors.append(f"missing {name}")
        elif "Generated by" not in path.read_text(encoding="utf-8"):
            errors.append(f"{name} missing generated marker")
    command_count = len(list((root / "adapters" / "claude" / "commands").glob("*.md")))
    active_count = len(list((root / "skills" / "active").glob("*/SKILL.md")))
    if command_count != active_count:
        errors.append(f"claude command count {command_count} != active skill count {active_count}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("surfaces ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

