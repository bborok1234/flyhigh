#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path


REQUIRED = ["bootstrap", "run-artifact", "policy", "skills", "decision-memory", "dashboard", "skillopt", "adapters", "github-repositories", "github-ops", "operator-decisions", "hitl-governance"]


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    errors: list[str] = []
    for suite in REQUIRED:
        if not (root / "evals" / "suites" / suite).exists():
            errors.append(f"missing eval suite {suite}")
    result = subprocess.run(["scripts/run-eval-suite", "all"], cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    print(result.stdout)
    if result.returncode != 0:
        errors.append("run-eval-suite all failed")
    report = root / "evals" / "reports" / "all.json"
    if report.exists():
        data = json.loads(report.read_text(encoding="utf-8"))
        for item in data.get("results", []):
            for key in ["suite", "case", "score", "passed", "evidence"]:
                if key not in item:
                    errors.append(f"eval result missing {key}")
    else:
        errors.append("missing evals/reports/all.json")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("evals ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
