#!/usr/bin/env python3
import argparse
import json
import subprocess
from pathlib import Path


def load_rows(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def write_rows(path: Path, rows: list[dict]) -> None:
    path.write_text("\n".join(json.dumps(row, ensure_ascii=False) for row in rows) + "\n", encoding="utf-8")


def body_for(row: dict) -> str:
    linked = "\n".join(f"- {item}" for item in row.get("linked_items", [])) or "- none"
    evidence = "\n".join(f"- `{item}`" for item in row.get("evidence", [])) or "- none"
    labels = ", ".join(row.get("labels", [])) or "none"
    return f"""# {row.get('title')}

## 왜 필요한가

{row.get('why')}

## 본문

{row.get('body')}

## 연결된 Flyhigh 항목

{linked}

## 근거

{evidence}

## Labels

{labels}
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Render approved or staged GitHub operations into local markdown outbox files.")
    parser.add_argument("--id")
    parser.add_argument("--include-unapproved", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    path = root / "state" / "github" / "operations.jsonl"
    outbox = root / "state" / "github" / "outbox"
    outbox.mkdir(parents=True, exist_ok=True)
    rows = load_rows(path)
    prepared = []
    for row in rows:
        if args.id and row.get("id") != args.id:
            continue
        if row.get("status") not in {"approved", "prepared"} and not args.include_unapproved:
            continue
        target = outbox / f"{row.get('id')}-{row.get('kind')}.md"
        target.write_text(body_for(row), encoding="utf-8")
        row["outbox_path"] = target.relative_to(root).as_posix()
        if row.get("status") in {"approved", "prepared"}:
            row["status"] = "prepared"
            row["lane"] = "prepared"
            row["next_action"] = "사용자 승인 상태와 dry-run 결과 확인 후 publish 명령을 실행한다."
        prepared.append(row.get("id"))
    write_rows(path, rows)
    subprocess.run(["scripts/render-dashboard"], cwd=root, check=False)
    print(f"prepared {len(prepared)} operations: {', '.join(prepared)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
