#!/usr/bin/env python3
import argparse
import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Initialize a SkillOpt-style improvement cycle.")
    parser.add_argument("--skill", required=True)
    parser.add_argument("--id", required=True)
    parser.add_argument("--evidence", action="append", default=[])
    parser.add_argument("--reflection", default="")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    out = root / "state" / "skillopt" / "runs" / f"{args.id}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps({
        "id": args.id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "skill": args.skill,
        "rollout_evidence": args.evidence,
        "minibatch_reflection": args.reflection,
        "status": "initialized"
    }, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    subprocess.run(["scripts/render-dashboard"], cwd=root, check=False)
    print(f"initialized {out.relative_to(root)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
