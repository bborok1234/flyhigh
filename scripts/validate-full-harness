def run(root: Path, command: list[str]) -> dict:
    result = subprocess.run(command, cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    return {"command": " ".join(command), "returncode": result.returncode, "output": result.stdout.strip()}


def scan_domain_terms(root: Path) -> list[str]:
    hits: list[str] = []
    ignored_parts = {".git"}
    ignored_prefixes = {"evals/reports"}
    for path in root.rglob("*"):
        if any(part in ignored_parts for part in path.parts):
            continue
        if not path.is_file():
            continue
        relative = path.relative_to(root).as_posix()
        if any(relative.startswith(prefix) for prefix in ignored_prefixes):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        lowered = text.lower()
        for term in DOMAIN_TERMS:
            if term in lowered:
                hits.append(f"{relative}:{term}")
    return hits


def validate_dashboard(root: Path) -> list[str]:
    html = (root / "dashboard" / "flyhigh.html").read_text(encoding="utf-8") if (root / "dashboard" / "flyhigh.html").exists() else ""
    required = ["운영 브리핑", "Decision Console", "운영자 결정 없음", "Dashboard freshness", "validate-dashboard-freshness", "Live state", "live-observed", "open issues", "open PRs", "Target project delivery", "Product UI is not rendered inline here", "research_report.v1", "GitHub repository mapping", "Direction review", "Merge gates", "이슈 액션", "PR 액션", "Blockers", "게시 가능", "지금 판단할 항목", "작업 칸반", "GitHub 운영 보드", "최근 반복 로그", "결정 메모리", "Eval 결과", "시스템 표면"]
    errors = [f"dashboard missing phrase: {phrase}" for phrase in required if phrase not in html]
    for phrase in ["MyBroker product pivot", "Top action candidate:", "MiroFish 참고 초보자 보기"]:
        if phrase in html:
            errors.append(f"dashboard contains inline product UI phrase: {phrase}")
    if "운영자 결정 없음" not in html:
        for phrase in ["추천", "선택지", "영향", "승인 범위", "Apply gate", "에이전트에게 전달할 명령", "실행 경로"]:
            if phrase not in html:
                errors.append(f"dashboard missing active decision phrase: {phrase}")
    return errors


def validate_docs(root: Path) -> list[str]:
    errors = []
    readme = (root / "README.md").read_text(encoding="utf-8")
    for phrase in ["scripts/validate-full-harness", "scripts/render-dashboard", "scripts/validate-dashboard-freshness", "scripts/validate-dashboard-truth", "scripts/sync-github-state", "scripts/record-decision", "scripts/promote-skill", "scripts/install-into-project", "scripts/validate-github-ops", "scripts/validate-github-repositories", "scripts/validate-operator-decisions", "scripts/validate-hitl-governance", "scripts/validate-direction-reviews", "scripts/validate-merge-gates", "scripts/validate-dashboard-quality"]:
        if phrase not in readme:
            errors.append(f"README missing {phrase}")
    return errors


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    failures: list[str] = []
    results = []
    for name, command in CHECKS:
        result = run(root, command)
        results.append({"name": name, **result})
        print(f"{name}: {'pass' if result['returncode'] == 0 else 'fail'}")
        if result["returncode"] != 0:
            failures.append(name)

    missing = [path for path in REQUIRED_FILES if not (root / path).exists()]
    for path in missing:
        print(f"missing {path}", file=sys.stderr)
    if missing:
        failures.append("required files")

    for error in validate_dashboard(root):
        print(error, file=sys.stderr)
        failures.append("dashboard content")
    for error in validate_docs(root):
        print(error, file=sys.stderr)
        failures.append("docs")

    domain_hits = scan_domain_terms(root)
    for hit in domain_hits:
        print(f"domain term hit: {hit}", file=sys.stderr)
    if domain_hits:
        failures.append("domain neutrality")
    else:
        print("domain neutrality: pass")

    report = root / "evals" / "reports" / "full-harness-validation.json"
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps({"failures": failures, "results": results}, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"wrote {report.relative_to(root)}")
    if failures:
        print(f"validate-full-harness failed: {', '.join(sorted(set(failures)))}", file=sys.stderr)
        return 1
    render_result = run(root, ["scripts/render-dashboard"])
    print(f"dashboard render: {'pass' if render_result['returncode'] == 0 else 'fail'}")
    if render_result["returncode"] != 0:
        print(render_result["output"], file=sys.stderr)
        return render_result["returncode"]
    freshness_result = run(root, ["scripts/validate-dashboard-freshness"])
    print(f"dashboard freshness final: {'pass' if freshness_result['returncode'] == 0 else 'fail'}")
    if freshness_result["returncode"] != 0:
        print(freshness_result["output"], file=sys.stderr)
        return freshness_result["returncode"]
    print("validate-full-harness ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
