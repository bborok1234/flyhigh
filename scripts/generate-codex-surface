#!/usr/bin/env python3
import json
import re
from pathlib import Path


FRONTMATTER = re.compile(r"^---\n(.*?)\n---\n", re.DOTALL)


def field(block: str, name: str) -> str:
    for line in block.splitlines():
        if line.startswith(f"{name}:"):
            return line.split(":", 1)[1].strip().strip('"')
    return ""


def skills(root: Path) -> list[dict[str, str]]:
    result = []
    for path in sorted((root / "skills" / "active").glob("*/SKILL.md")):
        text = path.read_text(encoding="utf-8")
        match = FRONTMATTER.match(text)
        if match:
            result.append({"slug": path.parent.name, "name": field(match.group(1), "name"), "description": field(match.group(1), "description")})
    return result


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    spec = json.loads((root / "spec" / "harness-spec.json").read_text(encoding="utf-8"))
    out_dir = root / "adapters" / "codex"
    out_dir.mkdir(parents=True, exist_ok=True)
    lines = "\n".join(f"- `{item['name']}`: {item['description']}" for item in skills(root))
    text = f"""# Flyhigh Codex Surface

Generated by `scripts/generate-codex-surface`. Canonical source: `spec/harness-spec.json` and `skills/active`.

## Purpose

{spec['purpose']}

## Codex Operating Rules

- Use `AGENTS.md` for always-on project rules.
- Use Flyhigh active skills for repeatable workflows.
- Use run artifacts for large or reusable work.
- Keep decision memory current for durable choices.
- Run `scripts/validate-full-harness` before claiming harness completion.

## Active Skills

{lines}
"""
    (out_dir / "AGENTS.md").write_text(text, encoding="utf-8")
    print("codex surface generated")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

