#!/usr/bin/env python3
import sys
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    errors: list[str] = []
    required = [
        root / "adapters" / "claude" / "CLAUDE.md",
        root / "adapters" / "opencode" / "AGENTS.md",
    ]
    skill_root = root / "skills" / "active"
    if not skill_root.exists():
        skill_root = root / "skills"
    skills = sorted(skill_root.glob("*/SKILL.md"))
    for path in required:
        if not path.exists():
            errors.append(f"missing {path.relative_to(root)}")
        elif "Generated by `scripts/generate-adapters`" not in path.read_text(encoding="utf-8"):
            errors.append(f"{path.relative_to(root)} missing generated marker")

    commands = root / "adapters" / "claude" / "commands"
    for skill in skills:
        command = commands / f"{skill.parent.name}.md"
        if not command.exists():
            errors.append(f"missing {command.relative_to(root)}")

    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print(f"adapters ok ({len(skills)} commands)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
