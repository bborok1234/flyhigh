#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Apply a staged bounded skill patch to a candidate SKILL.md.")
    parser.add_argument("candidate_id")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    candidate_dir = root / "skills" / "staging" / args.candidate_id
    patch_path = candidate_dir / "patch.json"
    if not patch_path.exists():
        print(f"missing {patch_path}", file=sys.stderr)
        return 1
    patch = json.loads(patch_path.read_text(encoding="utf-8"))
    active = root / "skills" / "active" / patch["skill"] / "SKILL.md"
    if not active.exists():
        print(f"missing active skill {active}", file=sys.stderr)
        return 1
    candidate_skill_dir = candidate_dir / patch["skill"]
    candidate_skill_dir.mkdir(parents=True, exist_ok=True)
    candidate = candidate_skill_dir / "SKILL.md"
    shutil.copyfile(active, candidate)
    text = candidate.read_text(encoding="utf-8")
    if patch["operation"] == "add":
        text = text.rstrip() + "\n\n" + patch["replacement"].strip() + "\n"
    elif patch["operation"] == "replace":
        if patch["target"] not in text:
            print("replace target not found", file=sys.stderr)
            return 1
        text = text.replace(patch["target"], patch["replacement"], 1)
    elif patch["operation"] == "delete":
        if patch["target"] not in text:
            print("delete target not found", file=sys.stderr)
            return 1
        text = text.replace(patch["target"], "", 1)
    candidate.write_text(text, encoding="utf-8")
    patch["status"] = "applied"
    patch_path.write_text(json.dumps(patch, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    subprocess.run(["scripts/render-dashboard"], cwd=root, check=False)
    print(f"applied {args.candidate_id}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
