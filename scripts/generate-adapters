#!/usr/bin/env python3
import re
from pathlib import Path


FRONTMATTER = re.compile(r"^---\n(.*?)\n---\n", re.DOTALL)


def parse_field(block: str, field: str) -> str:
    for line in block.splitlines():
        if line.startswith(f"{field}:"):
            return line.split(":", 1)[1].strip().strip('"')
    return ""


def load_skills(root: Path) -> list[dict[str, str]]:
    skills = []
    skill_root = root / "skills" / "active"
    if not skill_root.exists():
        skill_root = root / "skills"
    for skill in sorted(skill_root.glob("*/SKILL.md")):
        text = skill.read_text(encoding="utf-8")
        match = FRONTMATTER.match(text)
        if not match:
            continue
        block = match.group(1)
        skills.append(
            {
                "slug": skill.parent.name,
                "name": parse_field(block, "name"),
                "description": parse_field(block, "description"),
            }
        )
    return skills


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    skills = load_skills(root)
    claude_root = root / "adapters" / "claude"
    commands_root = claude_root / "commands"
    opencode_root = root / "adapters" / "opencode"
    commands_root.mkdir(parents=True, exist_ok=True)
    opencode_root.mkdir(parents=True, exist_ok=True)

    skill_lines = "\n".join(f"- `{item['name']}`: {item['description']}" for item in skills)
    claude = f"""# Flyhigh Claude Adapter

Generated by `scripts/generate-adapters`. Do not treat this file as canonical.

Flyhigh is Codex-first. This adapter maps the canonical Flyhigh skills into Claude Code-friendly instructions.

## Core Rules

- Keep work domain-neutral unless the target project supplies domain instructions.
- Prefer project-local conventions.
- Preserve user changes.
- Use Flyhigh run artifacts, memory, policy, evals, and dashboard conventions when relevant.

## Skills

{skill_lines}
"""
    (claude_root / "CLAUDE.md").write_text(claude, encoding="utf-8")

    for item in skills:
        command = f"""# /{item['slug']}

Generated wrapper for `{item['name']}`.

Use the canonical Flyhigh skill:

- Name: `{item['name']}`
- Description: {item['description']}

Follow the corresponding `skills/{item['slug']}/SKILL.md` workflow and report validation evidence.
"""
        (commands_root / f"{item['slug']}.md").write_text(command, encoding="utf-8")

    opencode = f"""# Flyhigh OpenCode Adapter

Generated by `scripts/generate-adapters`. Canonical behavior lives in Flyhigh skills and references.

## Operating Rules

- Use Flyhigh as a local-first engineering harness, not as a separate runtime.
- Keep changes scoped and evidence-backed.
- Use generated run artifacts for substantial work.
- Update project memory only with durable facts.

## Available Flyhigh Skills

{skill_lines}
"""
    (opencode_root / "AGENTS.md").write_text(opencode, encoding="utf-8")

    print("adapters generated")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
